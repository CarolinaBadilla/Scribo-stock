# ==============================================================================
# CONFIGURACIÓN DEL FRONTEND (VITE + REACT)
# ==============================================================================
# URL base del backend Express (incluyendo el prefijo /api)
VITE_API_URL=http://localhost:3000/api

# ==============================================================================
# FEATURE FLAG: MÓDULO DE PAGOS Y HARDWARE LOCAL
# ==============================================================================
# Si es 'false' o no existe, la pantalla de ventas mantiene la interfaz original
# de 2 medios (Efectivo/Tarjeta) y no invoca hardware ni polling.
# Si es 'true', activa el SelectorPago (Efectivo c/ Web Serial, MP QR y Posnet).
VITE_ENABLE_PAYMENTS_MODULE=true


