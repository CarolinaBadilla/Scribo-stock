# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (SCRIBO POS)
# ==============================================================================
PORT=3000
DATABASE_URL=postgresql://postgres:Scribo_db_pass@postgres_scribo:5432/scribo_db
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_para_entorno_de_desarrollo_scribo_2026
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# MÓDULO DE PAGOS, FACTURACIÓN Y HARDWARE (FEATURE FLAG)
# ==============================================================================
# Activa o desactiva por completo las rutas de pagos (/api/pagos/*).
# Si está en 'false' o no existe, todas las rutas devuelven 404 Not Found.
ENABLE_PAYMENTS_MODULE=true

# Modo Simulación (true para desarrollo local sin terminales físicas ni pagos reales)
MP_MOCK_MODE=true

# Credenciales de Integración de Mercado Pago (In-Store QR y Point)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_USER_ID=3834329853
MP_STORE_ID=83097397
MP_POS_ID=140722813

# ID del Dispositivo Terminal Point (o SIMULATOR_DEVICE_01 para modo mock)
MP_POINT_DEVICE_ID=SIMULATOR_DEVICE_01

# URL pública del servidor accesible para recibir webhooks de Mercado Pago (ej. Cloudflare Tunnel, ngrok o dominio)
API_URL=https://tu-tunel-o-dominio.trycloudflare.com
